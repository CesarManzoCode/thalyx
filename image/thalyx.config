# The kernel Thalyx needs, and nothing else.
#
# Applied on top of `allnoconfig`, which starts from nothing. That direction
# matters: a distribution kernel with things switched off still contains
# everything nobody remembered to switch off, and nobody can say what is in it.
# Here, what is on is what somebody put here.
#
# NEVER BUILT. The machine this was written on cannot reach kernel.org. Expect
# the first build to want things that are missing — every one of those is a line
# this file should have had, and adding it is the correct fix.

# --- being able to boot at all ---
CONFIG_64BIT=y
CONFIG_SMP=y
CONFIG_PRINTK=y
CONFIG_BINFMT_ELF=y
CONFIG_MULTIUSER=y
CONFIG_POSIX_TIMERS=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_SHMEM=y
CONFIG_AIO=y

# --- the console we are watched through ---
CONFIG_TTY=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_PRINTK_TIME=y

# --- the root filesystem is a cpio archive the kernel unpacks ---
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_DEVTMPFS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y

# --- Btrfs is mandatory: Journal-y-Snapshots.md, and restore depends on it ---
CONFIG_BTRFS_FS=y
CONFIG_BTRFS_FS_POSIX_ACL=y
CONFIG_CRYPTO_CRC32C=y
CONFIG_LIBCRC32C=y

# --- the disk the store lives on ---
CONFIG_PCI=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_BLOCK=y

# --- a module's confinement is a cgroup ---
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_SCHED=y
CONFIG_CGROUP_BPF=y

# --- the sandbox: namespaces, seccomp, idmapped mounts ---
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_USER_NS=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y

# --- thalyx-lsm. Without these there is no enforcement and Thalyx says so ---
CONFIG_SECURITY=y
CONFIG_SECURITYFS=y
CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_BPF_LSM=y
CONFIG_DEBUG_INFO_BTF=y
CONFIG_LSM="capability,bpf"

# --- networking, only so a module can be denied it ---
CONFIG_NET=y
CONFIG_INET=y
CONFIG_UNIX=y
