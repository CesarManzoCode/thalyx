# Obsidian per-machine state (the shared config is tracked)
vault/.obsidian/workspace.json
vault/.obsidian/workspace-mobile.json
vault/.obsidian/cache/
vault/.obsidian/plugins/*/data.json

# OS noise
.DS_Store
Thumbs.db

# Rust
/target/
**/*.rs.bk

# Development VM artifacts (large, machine-local)
dev/.vm/

# BPF build output. `lsm/vmlinux.h` is NOT here: it used to be generated by
# bpftool from the running kernel's BTF, and is now written by hand and part of
# the repository. Ignoring it would mean a clone that cannot build the kernel
# side at all, with no message saying why.
lsm/*.o

# Build directory for dev/verify.sh, which runs as root.
dev/.verify-target/

# What `make -C image` builds: the kernel source tree, the bzImage, the
# initramfs, the store disk, and the doctor's scratch files. All of it is
# reproducible from this repository and none of it belongs in it.
image/build/
